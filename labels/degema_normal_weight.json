{
  "schema_version": 1,
  "template_code": "degema_normal_weight",
  "label": "DeGema Etiqueta Normal - Peso",
  "description": "Etiqueta normal de peso frente e verso 75.6x49.9 mm com peso a 3 casas decimais, unidade kg, codigo de barras com peso, dados da empresa e pagina de composicao.",
  "source": {
    "type": "bundled",
    "mapped_on": "2026-05-19"
  },
  "unit": "mm",
  "format_code": "CUSTOM_76X50",
  "label_size_mm": {
    "width": 75.6,
    "height": 49.9
  },
  "dolibarr_format_hint": {
    "paper_size": "custom",
    "custom_x_mm": 75.6,
    "custom_y_mm": 49.9,
    "orientation": "P",
    "nx": 1,
    "ny": 1,
    "leftmargin_mm": 0.0,
    "topmargin_mm": 0.0,
    "spacex_mm": 0.0,
    "spacey_mm": 0.0
  },
  "assets": [
    {
      "asset_key": "brand_badge",
      "type": "image",
      "required": false,
      "notes": "Imagem opcional de selo/logótipo no canto superior direito."
    },
    {
      "asset_key": "green_dot_symbol",
      "type": "image",
      "required": true,
      "notes": "Símbolo Green Dot obrigatório da embalagem."
    },
    {
      "asset_key": "eu_food_contact_material_symbol",
      "type": "image",
      "required": true,
      "notes": "Símbolo obrigatório da UE para material em contacto com alimentos."
    }
  ],
  "inputs": [
    {
      "source": "batch.packaged_at",
      "label": "Embalado em",
      "type": "date",
      "editable": true,
      "output_format": "d/m/Y",
      "placeholder": "30/09/2024"
    },
    {
      "source": "label.weight_value",
      "label": "Peso",
      "type": "number",
      "editable": true,
      "min": "0",
      "step": "0.001",
      "default_value": "1.000",
      "placeholder": "1.000"
    },
    {
      "source": "label.weight_unit",
      "label": "Unidade do peso",
      "type": "select",
      "editable": true,
      "default_value": "kg",
      "options": [
        {
          "value": "kg",
          "label": "kg"
        },
        {
          "value": "g",
          "label": "g"
        },
        {
          "value": "mg",
          "label": "mg"
        },
        {
          "value": "onça",
          "label": "onça"
        }
      ]
    },
    {
      "source": "batch.validity_days",
      "label": "Validade (dias)",
      "type": "number",
      "editable": true,
      "min": 0,
      "step": 1,
      "default_value": "180",
      "placeholder": "180"
    },
    {
      "source": "batch.lot_number",
      "label": "Lote",
      "type": "text",
      "editable": true,
      "placeholder": "20240930"
    },
    {
      "source": "label.ingredients_section",
      "label": "Ingredientes",
      "type": "textarea",
      "editable": true,
      "rows": 6
    },
    {
      "source": "label.allergens_section",
      "label": "Alergénios",
      "type": "textarea",
      "editable": true,
      "rows": 4
    },
    {
      "source": "label.nutrition_section",
      "label": "Declaração nutricional",
      "type": "textarea",
      "editable": true,
      "rows": 5
    },
    {
      "source": "company.name_with_vat",
      "label": "Entidade",
      "type": "text",
      "editable": true
    },
    {
      "source": "company.address_singleline",
      "label": "Morada",
      "type": "text",
      "editable": true
    },
    {
      "source": "label.storage_text",
      "label": "Conservação",
      "type": "textarea",
      "editable": true,
      "rows": 4,
      "default_value": "CONSERVAÇÃO: 0°C a 4°C."
    },
    {
      "source": "asset.brand_badge",
      "label": "Imagem da marca",
      "type": "image",
      "editable": true,
      "default_value": "templates/assets/degema_bw.svg"
    },
    {
      "source": "asset.green_dot_symbol",
      "label": "Símbolo Green Dot",
      "type": "image",
      "editable": false,
      "default_value": "templates/assets/green_dot_symbol.svg"
    },
    {
      "source": "asset.eu_food_contact_material_symbol",
      "label": "Símbolo UE de contacto alimentar",
      "type": "image",
      "editable": false,
      "default_value": "templates/assets/eu_food_contact_material_symbol.svg"
    }
  ],
  "computed_fields": [
    {
      "operation": "add_days",
      "days_source": "batch.validity_days",
      "base_source": "batch.packaged_at",
      "base_fallback_sources": [],
      "target_source": "batch.expiry_at",
      "output_format": "d/m/Y"
    },
    {
      "operation": "weight_ean13",
      "prefix": "27",
      "product_code_source": "product.ref",
      "weight_source": "label.weight_value",
      "unit_source": "label.weight_unit",
      "target_source": "label.weight_barcode",
      "product_code_fallback_sources": [
        "product.barcode"
      ]
    },
    {
      "operation": "weight_line",
      "weight_source": "label.weight_value",
      "unit_source": "label.weight_unit",
      "target_source": "label.weight_line"
    }
  ],
